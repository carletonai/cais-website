{
  "name": "cais-website",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "A project for CAIS club website.",
  "type": "module",
  "homepage": "https://carletonai.com",
  "scripts": {
    "serve": "vite preview",
    "dev": "vite",
    "build": "vite build && node scripts/prerender-routes.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:contrast": "node scripts/a11y-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint:check && npm run format:check",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "fix": "npm run lint && npm run format",
    "push": "git commit --allow-empty -m \"SKIP CI commit [skip ci]\" && git push origin master"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "react-social-icons": "^6.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-jest": "^30.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lucide-react": "^1.53.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carletonai/cais-website.git"
  },
  "bugs": {
    "url": "https://github.com/carletonai/cais-website/issues"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "carleton",
    "ai",
    "society",
    "club",
    "website"
  ],
  "contributors": [
    {
      "name": "Tarek Ibrahim",
      "email": "tarekibrahim3@cmail.carleton.ca"
    },
    {
      "name": "Angus Bailey",
      "email": "AngusBailey@cmail.carleton.ca"
    }
  ],
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "@istanbuljs/load-nyc-config>js-yaml": "^4.3.2"
    }
  }
}
